APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=cwm_pgsql
DB_PORT=5432
DB_DATABASE=celebrateitwithme
DB_USERNAME=cwm
DB_PASSWORD=password
# Databases that migrate:fresh/refresh/reset and db:wipe refuse to touch (comma separated).
# To override deliberately set ALLOW_DESTRUCTIVE_DB=1 in the command environment, never in this file.
PROTECTED_DB_NAMES=celebrateitwithme

BROADCAST_DRIVER=log
# Stateless app (PaaS): cache, sessions and queue live in Redis; files live in S3-compatible disks (see below).
# CACHE_DRIVER is the legacy name of CACHE_STORE and still works. Without Redis: file / database / sync.
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# A worker must run for the queue (mail, invoices, WhatsApp): php artisan queue:work --tries=3 --max-time=3600
# and the scheduler: cron `* * * * * php artisan schedule:run` (or `php artisan schedule:work`).
# Compression of JSON/CSS by the app itself; set false when the PaaS router or CDN already gzips/brotlis.
HTTP_COMPRESSION=true
# Seconds the guest-independent part of the public invitation is kept (it is also renewed on every edit).
INVITATION_CACHE_TTL=300
# Disk of avatars, location photos, dress-code images and the background song: s3 on a PaaS (ephemeral disk).
# unset = s3 when APP_ENV=production, local otherwise. event-media / sweet-memories / template-packages have their own *_DRIVER.
# PUBLIC_DISK_DRIVER=s3
# EVENT_MEDIA_DRIVER=s3
# SWEET_MEMORIES_DRIVER=s3
# TEMPLATE_PACKAGES_DRIVER=s3
# Each *_DRIVER accepts local | s3 | r2 (r2 = Cloudflare R2, built with the R2_* keys below).
# Disk of the public media written by the app (avatars, location photos, dress code, song): public locally, r2 on staging/production.
# MEDIA_DISK=r2
# Private files (invoices PDF): INVOICING_DISK=r2_private. Theme assets use FILESYSTEM_DISK (set it to r2 on a PaaS).
# INVOICING_DISK=r2_private
# PACKAGES_STAGING_DISK=r2_private
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

# Inside Docker the host is the container name; a PaaS gives REDIS_URL (use it instead of host/port).
REDIS_HOST=cwm_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit catches every mail (inbox at http://localhost:8025). Preview gallery: /dev/mail (APP_ENV=local only).
MAIL_MAILER=smtp
MAIL_HOST=cwm_mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Staging/production (Resend over SMTP; domain quinvite.com verified there). Put the real values only in the server env, never in git:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=<Resend API key, sending access>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="hola@quinvite.com"
# MAIL_FROM_NAME="Quinvite"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible). Leave empty locally. Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false
# Media bucket and its public domain without cookies (e.g. https://cdn.quinvite.com; NOTE: SESSION_DOMAIN=.quinvite.com also sends the session cookie there, see the R2 guide)
R2_BUCKET=
R2_URL=
# Template packages bucket; its public domain goes in TEMPLATE_PACKAGES_URL (one custom domain per bucket, e.g. https://packages.quinvite.com or the same cdn host with a path rule; static files only)
R2_PACKAGES_BUCKET=
TEMPLATE_PACKAGES_URL=
# Private bucket (invoices, exports): no public domain
R2_PRIVATE_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Support: the address people are pointed to, and the admin panel the support mail links to
SUPPORT_EMAIL=soporte@quinvite.com
ADMIN_URL=http://dev.admin.cwm.com
# Public URL of the SPA. Without it the email verification link redirects to the API URL.
APP_FRONT_URL=http://dev.app.cwm.com
# --- Social login (Google / Facebook via Socialite). Leave empty to keep the provider disabled; never commit real values. ---
# Where the SPA lives: the OAuth callback sends the browser to SPA_URL/auth/social/callback?status=ok|error&provider=&reason=&redirect=
# (defaults to APP_FRONT_URL when unset).
SPA_URL=http://dev.app.cwm.com
# Redirect URIs are the API's own callback registered at each provider, e.g. https://api.example.com/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://dev.api.cwm.com/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://dev.api.cwm.com/oauth/facebook/callback
# The callback logs in with the cookie session, so the session cookie must be shared between API and SPA hosts in production:
# SESSION_DOMAIN=.example.com, SESSION_SECURE_COOKIE=true and SANCTUM_STATEFUL_DOMAINS=app.example.com (see the production checklist below).
# Hosts an announcement button may link to (comma separated, `*.quinvite.com` allows subdomains). Empty = APP_URL, APP_FRONT_URL,
# SPA_URL, ADMIN_URL and quinvite.com with its subdomains. Internal paths are allowed, except sensitive ones (/impersonate...).
ANNOUNCEMENT_ALLOWED_HOSTS=

# Load balancer / CDN addresses whose X-Forwarded-For is trusted (comma separated, CIDR ok). Needed in production behind a
# proxy or every per-IP limit counts the proxy as one person. Use `*` only if the proxy always overwrites the header.
TRUSTED_PROXIES=

# Payments. Production needs a real gateway (not "fake") and a webhook secret (openssl rand -hex 32): the app refuses
# to boot in production otherwise. The secret has no default.
PAYMENTS_GATEWAY=fake
PAYMENTS_WEBHOOK_SECRET=

# hCaptcha on register and login (the app needs the matching site key in VITE_APP_HCAPTCHA_SITE_KEY)
HCAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Production checklist (php artisan app:doctor lists what is still unsafe; the app refuses to boot in production) ---
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.example.com
# SANCTUM_STATEFUL_DOMAINS=app.example.com        (the organizers' SPA only: the admin panel uses Bearer tokens)
# ALLOWED_SPA_DOMAINS=https://app.example.com,https://admin.example.com
# DEFAULT_ADMIN_EMAIL=  /  DEFAULT_ADMIN_PASSWORD=   (first superadmin; nothing is created without them outside local)
# ADMIN_REQUIRE_2FA_SUPERADMIN=true
# PAYMENTS_GATEWAY / PAYMENTS_WEBHOOK_SECRET / HCAPTCHA_* as above

# WhatsApp (Meta Cloud API). `fake` sends nothing and needs no account; `meta` needs every value below.
WHATSAPP_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_MAX_DAILY_PER_EVENT=
WHATSAPP_MAX_DAILY_PER_ACCOUNT=1000

# Spotify catalogue search for suggested music (server side; create the app in the Spotify developer dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Global API limiter (requests per minute per user or IP)
API_RATE_LIMIT_PER_MINUTE=120
