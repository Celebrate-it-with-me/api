APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=cwm_pgsql
DB_PORT=5432
DB_DATABASE=celebrateitwithme
DB_USERNAME=cwm
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit catches every mail (inbox at http://localhost:8025). Preview gallery: /dev/mail (APP_ENV=local only).
MAIL_MAILER=smtp
MAIL_HOST=cwm_mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Support: the address people are pointed to, and the admin panel the support mail links to
SUPPORT_EMAIL=soporte@quinvite.com
ADMIN_URL=http://dev.admin.cwm.com
# Hosts an announcement button may link to (comma separated, `*.quinvite.com` allows subdomains). Empty = APP_URL, APP_FRONT_URL,
# SPA_URL, ADMIN_URL and quinvite.com with its subdomains. Internal paths are allowed, except sensitive ones (/impersonate...).
ANNOUNCEMENT_ALLOWED_HOSTS=

# Payments. Production needs a real gateway (not "fake") and a webhook secret (openssl rand -hex 32): the app refuses
# to boot in production otherwise. The secret has no default.
PAYMENTS_GATEWAY=fake
PAYMENTS_WEBHOOK_SECRET=

# hCaptcha on register and login (the app needs the matching site key in VITE_APP_HCAPTCHA_SITE_KEY)
HCAPTCHA_ENABLED=false
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Production checklist (php artisan app:doctor lists what is still unsafe; the app refuses to boot in production) ---
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.example.com
# SANCTUM_STATEFUL_DOMAINS=app.example.com        (the organizers' SPA only: the admin panel uses Bearer tokens)
# ALLOWED_SPA_DOMAINS=https://app.example.com,https://admin.example.com
# DEFAULT_ADMIN_EMAIL=  /  DEFAULT_ADMIN_PASSWORD=   (first superadmin; nothing is created without them outside local)
# ADMIN_REQUIRE_2FA_SUPERADMIN=true
# PAYMENTS_GATEWAY / PAYMENTS_WEBHOOK_SECRET / HCAPTCHA_* as above

# WhatsApp (Meta Cloud API). `fake` sends nothing and needs no account; `meta` needs every value below.
WHATSAPP_DRIVER=fake
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_MAX_DAILY_PER_EVENT=
WHATSAPP_MAX_DAILY_PER_ACCOUNT=1000

# Spotify catalogue search for suggested music (server side; create the app in the Spotify developer dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Global API limiter (requests per minute per user or IP)
API_RATE_LIMIT_PER_MINUTE=120
